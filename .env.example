# 火山引擎大模型语音识别 API 配置
# 复制此文件为 .env 并填入实际密钥

# 控制台获取的 App ID
VOLCENGINE_APP_KEY=your_app_key_here

# 控制台获取的 Access Token
VOLCENGINE_ACCESS_KEY=your_access_key_here

# 资源ID（按量付费使用 duration，并发包使用 concurrent）
VOLCENGINE_RESOURCE_ID=volc.bigasr.sauc.duration

# ───────────── 实时翻译（OpenAI 兼容接口，可选）─────────────
# 默认使用 DeepSeek V4.1 Flash，API Key 在 https://platform.deepseek.com 获取；留空则不启用翻译
# 也可以在程序的「翻译设置」里填写，保存后会写回本文件
TRANSLATE_API_KEY=
TRANSLATE_BASE_URL=https://api.deepseek.com
TRANSLATE_MODEL=deepseek-flash

# 以下为可选项，保持注释即使用默认值
# 附加请求参数（JSON，合并进请求体）。DeepSeek 默认 {"thinking": {"type": "disabled"}} 关闭思考模式以降低延迟，
# 换用其他服务商时一般设为 {}
# TRANSLATE_EXTRA_BODY={}
# 目标语言
# TRANSLATE_TARGET_LANG=简体中文
# 启动时是否勾选翻译（默认：配置了 API Key 就勾选）
# TRANSLATE_ENABLED=true
# 附带的上文句数，帮助模型理解语境
# TRANSLATE_CONTEXT_SIZE=3
# 采样温度（默认不传，由服务商决定）
# TRANSLATE_TEMPERATURE=1.3
# 单次请求超时（秒）
# TRANSLATE_TIMEOUT=30
# 同时进行的翻译请求数
# TRANSLATE_MAX_CONCURRENCY=3
# 原文已是中文时跳过翻译
# TRANSLATE_SKIP_CHINESE=true
